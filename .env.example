# ---------------------------------------------------------------------------
# FFV2 PRO — environment
# Copy to .env for local development. Never commit the real .env file.
# ---------------------------------------------------------------------------

# HTTP port. Render injects PORT automatically; locally we default to 8080.
PORT=8080

# --- Turso (LibSQL) -------------------------------------------------------
# Leave these blank to use a local SQLite file (./data/local.db) for dev.
# Create a free database at https://turso.tech and paste the values here.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Admin / manual payment confirmation --------------------------------
# Long random string. Anyone holding this can issue licenses, so treat it
# like a password:  openssl rand -hex 32
ADMIN_SECRET=change-me-openssl-rand-hex-32

# --- bKash merchant details shown in the checkout modal -------------------
# Your bKash merchant (or personal "Send Money") number.
BKASH_MERCHANT_NUMBER=01XXXXXXXXX
BKASH_MERCHANT_NAME=FFV2 PRO
SUPPORT_CONTACT=@ffv2pro

# --- Comma separated list of allowed browser origins ----------------------
# In production set this to your Render URL, e.g.
# CORS_ORIGINS=https://ffv2-pro-access.onrender.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
